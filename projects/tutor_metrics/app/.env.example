# Copy to .env.local for local work. `vercel env pull .env.local --yes` writes the real ones.

# Neon, via `vercel integration add neon`. Pooled for the app, direct for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 32 random bytes each: `openssl rand -hex 32`
ADMIN_TOKEN=
CRON_SECRET=
IP_HASH_PEPPER=

# Which batch is being served. Change this string to cut over to a new one.
ACTIVE_BATCH_ID=b1

# Stamped on every label. Bump when the rules change, so a reinterpretation is visible later.
GUIDE_VERSION=guide-v1
NEXT_PUBLIC_UI_VERSION=ui-v1

# Optional. Without it /api/cron/snapshot reports the byte count and stores nothing.
BLOB_READ_WRITE_TOKEN=

# Optional. The calibration gate; defaults are 15 items and 10.5 to pass.
# QUIZ_SIZE=15
# QUIZ_PASS_MARK=10.5

# Local only, with scripts/devdb.ts: PGlite serves one client connection at a time.
# DB_POOL_MAX=1
